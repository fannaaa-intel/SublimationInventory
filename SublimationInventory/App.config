<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
	<connectionStrings>
		<!-- Server only (no database) - used once to CREATE DATABASE IF NOT EXISTS -->
		<add name="InventoryServer"
			 connectionString="Server=localhost;Port=3306;Uid=root;Pwd=;SslMode=None;"
			 providerName="MySql.Data.MySqlClient" />
		<!-- Main app connection -->
		<add name="InventoryDb"
			 connectionString="Server=localhost;Port=3306;Database=sublimationinventory;Uid=root;Pwd=;SslMode=None;"
			 providerName="MySql.Data.MySqlClient" />
	</connectionStrings>
</configuration>