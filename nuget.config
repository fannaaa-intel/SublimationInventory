<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins the package source so "nuget restore" / "Restore NuGet Packages"
  works on a fresh clone even if a machine has odd feed settings.
  This is a packages.config project, so packages land in .\packages\
  (gitignored) and must be restored before the first build.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <add key="repositoryPath" value="packages" />
  </config>
</configuration>
